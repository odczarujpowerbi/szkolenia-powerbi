# Skopiuj do .env (nigdy nie commituj prawdziwego .env — jest w .gitignore)
# i wypełnij prawdziwymi wartościami z lokalnego magazynu sekretów.

# Runner (PLAN-WDROZENIA.md sekcja 19) — API, nie subskrypcja interaktywna.
ANTHROPIC_API_KEY=

# Projectly — bez tego runner działa w trybie mock (projectly_client.py).
PROJECTLY_API_KEY=
PROJECTLY_BASE_URL=

# Opcjonalnie: nadpisuje domyślny dzienny limit kosztu (cost_tracker.py).
# DAILY_COST_LIMIT_USD=20.0
